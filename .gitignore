# Unity
unity/*/[Ll]ibrary/
unity/*/[Tt]emp/
unity/*/[Oo]bj/
unity/*/[Bb]uild/
unity/*/[Bb]uilds/
unity/*/[Ll]ogs/
unity/*/[Uu]ser[Ss]ettings/
unity/*/.vs/
unity/*/*.csproj
unity/*/*.sln
build/
# Blender
*.blend1
*.blend2
blender/out/
# python
__pycache__/
*.pyc
# large raw data
data/osm/raw_overpass.json
data/osm/raw_route.json

# Unity 公式 agent skills (npx skills experimental_install で復元。ライセンスが Other のため vendoring しない)
.agents/skills/
.claude/skills/

# Unity batch logs
unity/logs/

# 配布 zip (GitHub Release に置く。100 MB 超のため git には入れない)
dist/

# IDE / 一時ログ / デバッグ画像
unity/*/.vscode/
unity/*/*.slnx
unity/verify.log
docs/screenshots/_*.png
docs/previews/_dbg/

# WebGL ビルドの Burst 出力が Data/ に落ちる (ビルド生成物)
unity/*/Data/

# 校歌の作業用 WAV (mix.sh の中間, BGM の修正前原本など. 完成品は school_song/audio/)
tools/audio/school_song/work/
tools/audio/school_song/__pycache__/

# ambientCG から落とした zip (tools/fetch_textures.py が焼き直す元. 焼いた jpg だけ commit する)
data/textures/.cache/
